# Development Environment Variables
# Copy this file to .env.dev and fill in your values
# Usage: docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up -d --build

# HTTP URL of your server (no trailing slash)
SERVER_URL=http://YOUR_SERVER_IP

# WebSocket URL of your server (no trailing slash)
WS_URL=ws://YOUR_SERVER_IP
