# Production Environment Variables
# Copy this file to .env and fill in your values
# Usage: docker compose --env-file .env -f docker-compose.yml up -d --build

# HTTP URL of your server (no trailing slash)
# Example: http://your-domain.com or http://192.168.1.100
SERVER_URL=http://YOUR_SERVER_IP

# WebSocket URL of your server (no trailing slash)
# Example: ws://your-domain.com or ws://192.168.1.100
WS_URL=ws://YOUR_SERVER_IP
